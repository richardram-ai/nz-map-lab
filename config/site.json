  "categories": [
    { "id": "Observation", "label": "Observation", "colour": "#28699a" },
    { "id": "Planting", "label": "Planting", "colour": "#2c7a4b" },
    { "id": "Pest or weed", "label": "Pest or weed", "colour": "#b8334a" },
    { "id": "Issue", "label": "Issue", "colour": "#c47d14" }
  ],
  "identification": {
    "_about": "Shown next to any species choice. 'Not sure' and 'Other' records are marked as needing an ID and need a photo.",
    "confidence": [
      { "id": "sure", "label": "Sure" },
      { "id": "think", "label": "Think so" },
      { "id": "unsure", "label": "Not sure" }
    ],
    "photo_required_when_unsure": true,
    "classifier": true,
    "_classifier": "Offers species suggestions from a photo on list fields that ask how sure the person is. Uses the Aotearoa Species Classifier (TAIAO, University of Waikato, CC BY-NC 4.0) stored in /models/. Set to false to turn it off."
  },
  "tasks": [
    {
      "id": "observation",
      "label": "Observation",
      "hint": "Something seen: a bird, a plant, an animal",
      "category": "Observation",
      "title": "{species}",
      "fields": [
        { "id": "species", "label": "What did you see?", "type": "list", "list": "wildlife", "required": true, "unlisted_from_photo": 0.95,
          "_unlisted_from_photo": "A species not on the list, picked from a photo suggestion at this confidence or higher, is saved by name without needing an ID check." },
        { "id": "count", "label": "How many?", "type": "number", "min": 1, "max": 500, "default": 1 }
      ]
    },
    {
      "id": "planting",
      "label": "Planting",
      "hint": "Plants going in the ground",
      "category": "Planting",
      "title": "{species} × {count}",
      "fields": [
        { "id": "species", "label": "Species planted", "type": "list", "list": "plants", "required": true },
        { "id": "count", "label": "Number planted", "type": "number", "min": 1, "max": 1000, "default": 1, "required": true },
        { "id": "guard", "label": "Plant guard fitted?", "type": "yesno" }
      ]
    },
    {
      "id": "trap-check",
      "label": "Trap check",
      "hint": "Checking and re-baiting a trap",
      "category": "Pest or weed",
      "title": "Trap {trap}: {catch}",
      "fields": [
        { "id": "trap", "label": "Trap", "type": "list", "list": "traps", "required": true, "confidence": false, "title_uses": "id" },
        { "id": "catch", "label": "Catch", "type": "choice", "required": true,
          "options": ["Nothing", "Rat", "Mouse", "Stoat", "Weasel", "Ferret", "Hedgehog", "Possum", "Cat", "Bird (non-target)", "Sprung, empty", "Trap damaged"] },
        { "id": "rebaited", "label": "Re-baited?", "type": "yesno", "default": true }
      ]
    },
    {
      "id": "weed-survey",
      "label": "Weed survey",
      "hint": "A weed patch to deal with",
      "category": "Pest or weed",
      "title": "{species} ({size})",
      "fields": [
        { "id": "species", "label": "Weed", "type": "list", "list": "weeds", "required": true },
        { "id": "size", "label": "Patch size", "type": "choice", "required": true,
          "options": ["Single plant", "Small (under 1 m²)", "Medium (1–10 m²)", "Large (over 10 m²)"] },
        { "id": "treated", "label": "Treated today?", "type": "yesno" }
      ]
    },
    {
      "id": "general",
      "label": "Other",
      "hint": "Anything else: an issue, a note, an idea",
      "category": null,
      "title": "{title}",
      "fields": [
        { "id": "title", "label": "Title", "type": "text", "max": 80, "required": true }
      ]
    }
  ],
